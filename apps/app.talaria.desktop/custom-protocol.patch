diff --git a/desktop/src-tauri/Cargo.toml b/desktop/src-tauri/Cargo.toml
--- a/desktop/src-tauri/Cargo.toml
+++ b/desktop/src-tauri/Cargo.toml
@@ -28,6 +28,14 @@
 [dev-dependencies]
 tokio = { version = "1", features = ["macros", "rt"] }
 
+[features]
+# Production webview. Tauri treats the absence of custom-protocol as
+# cfg(dev) regardless of --release: generate_context! skips frontendDist
+# and the window loads tauri.conf.json's devUrl (http://localhost:5290).
+# Default-on so a plain cargo build --release actually ships the launcher.
+default = ["custom-protocol"]
+custom-protocol = ["tauri/custom-protocol"]
+
 # NOTE: tauri is pinned exactly (=2.11.5), not semver-ranged. Multiwebview
 # (Window::add_child) rides behind the `unstable` cargo feature, and unstable
 # features are exempt from semver guarantees — a caret here could silently
