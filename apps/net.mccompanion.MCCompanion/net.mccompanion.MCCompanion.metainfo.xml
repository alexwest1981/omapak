<component type="desktop-application">
  <id>net.mccompanion.MCCompanion</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>MCCompanion</name>
  <summary>The Minecraft companion app</summary>
  <description>
    <p>
      MCCompanion lets you connect to external Minecraft servers from
      PlayStation, Xbox, Nintendo Switch and other consoles, bridging
      any server to your local network so consoles can join as if it
      were a LAN game.
    </p>
    <p>
      It also packs tools for skins, player lookup, server tracking and
      a built-in wiki.
    </p>
  </description>
  <developer id="net.mccompanion">
    <name>MCCORG</name>
  </developer>
